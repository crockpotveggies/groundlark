    signal VA
    signal VBUS_SENSE
    signal VMID
    signal VZERO

    digital_supply = new ElectricPower
    digital_supply.hv ~ V3
    digital_supply.lv ~ GND
    digital_supply.voltage = 3.234V to 3.366V

    analog_supply = new ElectricPower
    analog_supply.hv ~ VA
    analog_supply.lv ~ GND
    analog_supply.voltage = 3.05V to 3.366V

    usb_supply = new ElectricPower
    usb_supply.hv ~ USB_5V
    usb_supply.lv ~ GND
    usb_supply.voltage = 4.35V to 5.25V

    j1 = new USB
    trait j1 has_designator<designator="J1">
    j1.pA1B12 ~ GND
    j1.pA4B9 ~ USB_VBUS
    j1.pA5 ~ CC1
    j1.pA6 ~ USB_DP
    j1.pA7 ~ USB_DM
    j1.pB4A9 ~ USB_VBUS
    j1.pB1A12 ~ GND
    j1.pB5 ~ CC2
    j1.pB6 ~ USB_DP
    j1.pB7 ~ USB_DM
    j1.pS1 ~ GND

    r1 = new R_5100
    trait r1 has_designator<designator="R1">
    r1.p1 ~ CC1
    r1.p2 ~ GND

    r2 = new R_5100
    trait r2 has_designator<designator="R2">
    r2.p1 ~ CC2
    r2.p2 ~ GND

    d1 = new ESD
    trait d1 has_designator<designator="D1">
    d1.p1 ~ USB_DP
    d1.p2 ~ GND
    d1.p3 ~ USB_DM
    d1.p4 ~ USB_DM
    d1.p5 ~ USB_VBUS
    d1.p6 ~ USB_DP

    d2 = new ESD
    trait d2 has_designator<designator="D2">
    d2.p1 ~ CC1
    d2.p2 ~ GND
    d2.p3 ~ CC2
    d2.p4 ~ CC2
    d2.p5 ~ USB_VBUS
    d2.p6 ~ CC1

    f1 = new FUSE
    trait f1 has_designator<designator="F1">
    f1.p1 ~ USB_VBUS
    f1.p2 ~ USB_5V

    u2 = new LDO
    trait u2 has_designator<designator="U2">
    u2.p1 ~ USB_5V
    u2.p2 ~ GND
    u2.p3 ~ USB_5V
    u2.p5 ~ V3
    u2.power ~ usb_supply

    c1 = new C_1u
    trait c1 has_designator<designator="C1">
