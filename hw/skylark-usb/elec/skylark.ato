    u7.p3 ~ VZERO
    u7.p4 ~ GND
    u7.p5 ~ VZERO
    u7.p6 ~ SO2_AE_SUM
    u7.p7 ~ SO2_AE_OUT
    u7.p8 ~ VA
    u7.power ~ analog_supply

    u8 = new OPA1
