    # Default-off analog rail and default-engaged electrode clamps permit USB
    # suspend with the higher-performance amplifiers. Resume requires settling.
    u1.p25 ~ ANA_EN
    u1.p26 ~ CLAMP_HOLD
    u13 = new AnalogSwitch
    trait u13 has_designator<designator="U13">
    u13.p1 ~ V3
    u13.p2 ~ GND
    u13.p3 ~ ANA_EN
    u13.p4 ~ ANA_CT
    u13.p5 ~ VA_SW
    u13.p6 ~ VA_SW
    q7 = new ClampNPN
    trait q7 has_designator<designator="Q7">
    q7.p1 ~ CLAMP_BASE
    q7.p2 ~ VZERO
    q7.p3 ~ CLAMP_GATE
    r72 = new R_100000
    trait r72 has_designator<designator="R72">
    r72.p1 ~ ANA_EN
    r72.p2 ~ GND
    r73 = new R_10000
    trait r73 has_designator<designator="R73">
    r73.p1 ~ V3
    r73.p2 ~ CLAMP_HOLD
    c73 = new C_1u
    trait c73 has_designator<designator="C73">
    c73.p1 ~ V3
    c73.p2 ~ GND
    c74 = new C_10n
    trait c74 has_designator<designator="C74">
    c74.p1 ~ ANA_CT
    c74.p2 ~ GND
    trait VA_SW has_net_name_suggestion<name="VA_SW", level="EXPECTED">
    trait ANA_EN has_net_name_suggestion<name="ANA_EN", level="EXPECTED">
    trait CLAMP_HOLD has_net_name_suggestion<name="CLAMP_HOLD", level="EXPECTED">
    trait ANA_CT has_net_name_suggestion<name="ANA_CT", level="EXPECTED">

    # Q7 holds gates just above VZERO; a grounded gate would forward-bias them.
    r74 = new R_10000
    trait r74 has_designator<designator="R74">
    r74.p1 ~ CLAMP_HOLD
    r74.p2 ~ CLAMP_BASE
    # Block a collapsing USB supply from actively pulling gates below VZERO.
    d4 = new GateDiode
    trait d4 has_designator<designator="D4">
    d4.p1 ~ USB_5V
    d4.p3 ~ GATE_SUPPLY
    trait CLAMP_BASE has_net_name_suggestion<name="CLAMP_BASE", level="EXPECTED">
    trait GATE_SUPPLY has_net_name_suggestion<name="GATE_SUPPLY", level="EXPECTED">

