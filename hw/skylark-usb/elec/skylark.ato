module Skylark:
    signal CLAMP_BASE
    signal GUARD
    signal GATE_SUPPLY
    signal VA_SW
    signal ANA_EN
    signal CLAMP_HOLD
    signal ANA_CT
    signal ADC_DRDY_N
    signal ADC_RESET_N
    signal BOOT0
    signal CC1
    signal CC2
    signal CLAMP_GATE
    signal GND
    signal H2S_AE
    signal H2S_AE_ADC
    signal H2S_AE_OUT
    signal H2S_AE_SUM
    signal H2S_CE
    signal H2S_CE_DRV
    signal H2S_RE
    signal H2S_RE_FB
    signal H2S_WE
    signal H2S_WE_ADC
    signal H2S_WE_OUT
    signal H2S_WE_SUM
    signal LED_A
    signal NRST
    signal PM_5V
    signal PM_EN
    signal PM_FAULT_N
    signal PM_ILIM
    signal PM_RESET
    signal PM_RESET_N
    signal PM_RX
    signal PM_SET_N
    signal PM_SLEEP
    signal PM_TX
    signal REF_2V5
    signal SCL
    signal SDA
    signal SO2_AE
    signal SO2_AE_ADC
    signal SO2_AE_OUT
    signal SO2_AE_SUM
