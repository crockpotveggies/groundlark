# Skylark Rev A: USB + PMS5003 + two independent four-electrode gas AFEs.
#pragma experiment("TRAITS")
import has_designator
import has_net_name_suggestion
import ElectricPower
from "../../shared/elec/skylark/parts.ato" import MCU
from "../../shared/elec/skylark/parts.ato" import USB
