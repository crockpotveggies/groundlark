    c87.p2 ~ H2S_AE_OUT

    # Isolate guard-pour capacitance from the VZERO buffer output.
    r75 = new R_100
    trait r75 has_designator<designator="R75">
    r75.p1 ~ VZERO
    r75.p2 ~ GUARD
