# Skylark USB Rev A. Physical pins; see ../README.md for operating limits.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import ElectricPower

component MCU:
    trait is_atomic_part<manufacturer="STMicroelectronics", partnumber="STM32F072CBT6", footprint="Package_QFP__LQFP-48_7x7mm_P0.5mm.kicad_mod", symbol="symbols/MCU.kicad_sym">
    trait has_designator_prefix<prefix="U">
    power = new ElectricPower
    power.hv ~ p24
    power.lv ~ p23
    assert power.voltage within 2V to 3.6V
    signal p7 ~ pin 7
    signal p44 ~ pin 44
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p18 ~ pin 18
    signal p19 ~ pin 19
    signal p20 ~ pin 20
    signal p39 ~ pin 39
    signal p40 ~ pin 40
    signal p41 ~ pin 41
    signal p42 ~ pin 42
    signal p43 ~ pin 43
    signal p45 ~ pin 45
    signal p46 ~ pin 46
    signal p21 ~ pin 21
    signal p22 ~ pin 22
    signal p25 ~ pin 25
    signal p26 ~ pin 26
    signal p27 ~ pin 27
    signal p28 ~ pin 28
    signal p1 ~ pin 1
    signal p24 ~ pin 24
    signal p48 ~ pin 48
    signal p23 ~ pin 23
    signal p35 ~ pin 35
    signal p47 ~ pin 47
    signal p9 ~ pin 9
    signal p8 ~ pin 8
    signal p36 ~ pin 36
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15
    signal p16 ~ pin 16
    signal p17 ~ pin 17
    signal p29 ~ pin 29
    signal p30 ~ pin 30
    signal p31 ~ pin 31
    signal p32 ~ pin 32
    signal p33 ~ pin 33
    signal p34 ~ pin 34
    signal p37 ~ pin 37
    signal p38 ~ pin 38

component USB:
    trait is_atomic_part<manufacturer="GCT", partnumber="USB4105-GF-A", footprint="Connector_USB__USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal.kicad_mod", symbol="symbols/USB.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal pA1 ~ pin A1
    signal pA4 ~ pin A4
    signal pA5 ~ pin A5
    signal pA6 ~ pin A6
    signal pA7 ~ pin A7
    signal pA8 ~ pin A8
    signal pA9 ~ pin A9
    signal pA12 ~ pin A12
    signal pB1 ~ pin B1
    signal pB4 ~ pin B4
    signal pB5 ~ pin B5
    signal pB6 ~ pin B6
    signal pB7 ~ pin B7
    signal pB8 ~ pin B8
    signal pB9 ~ pin B9
    signal pB12 ~ pin B12
    signal pS1 ~ pin S1

component ESD:
    trait is_atomic_part<manufacturer="STMicroelectronics", partnumber="USBLC6-2SC6", footprint="Package_TO_SOT_SMD__SOT-23-6.kicad_mod", symbol="symbols/ESD.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6

component LDO:
    trait is_atomic_part<manufacturer="Diodes Incorporated", partnumber="AP2112K-3.3TRG1", footprint="Package_TO_SOT_SMD__SOT-23-5.kicad_mod", symbol="symbols/LDO.kicad_sym">
    trait has_designator_prefix<prefix="U">
    power = new ElectricPower
    power.hv ~ p1
    power.lv ~ p2
    assert power.voltage within 2.5V to 6V
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5

component SWITCH:
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TPS2553DBVR", footprint="Package_TO_SOT_SMD__SOT-23-6.kicad_mod", symbol="symbols/SWITCH.kicad_sym">
