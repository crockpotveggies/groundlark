# Sensirion SHT4x datasheet v7: numbered pads viewed from top.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import ElectricPower

component SHT45:
    trait is_atomic_part<manufacturer="Sensirion", partnumber="SHT45-AD1B-R2", footprint="SHT45.kicad_mod", symbol="symbols/SHT45.kicad_sym">
    trait has_designator_prefix<prefix="U">
    power = new ElectricPower
    power.hv ~ p3
    power.lv ~ p4
    assert power.voltage within 1.08V to 3.6V
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
