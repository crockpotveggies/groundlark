# TI Pi supervisor atomic components. Pin assignments follow manufacturer data sheets.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component SUP_FUSE:
    trait is_atomic_part<manufacturer="Littelfuse", partnumber="0466004.NRHF", footprint="../../shared/elec/SUP_Fuse_1206_3216Metric.kicad_mod", symbol="../../shared/elec/symbols/SUP_FUSE.kicad_sym">
    trait has_designator_prefix<prefix="F">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component SUP_SWITCH:
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TPS22953DQCR", footprint="../../shared/elec/SUP_Texas_WSON10_DQC0010A.kicad_mod", symbol="../../shared/elec/symbols/SUP_SWITCH.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11

