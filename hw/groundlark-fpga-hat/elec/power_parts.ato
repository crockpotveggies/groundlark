# Dedicated Nexys-compatible 12 V FPGA power input.
# Manufacturer pin assignments are checked independently by fpga_power_checks.py.
#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix

component PWR_JACK:
    trait is_atomic_part<manufacturer="Same Sky", partnumber="PJ-102AH", footprint="../../shared/elec/PWR_BarrelJack_CUI_PJ-102AH_Horizontal.kicad_mod", symbol="../../shared/elec/symbols/PWR_JACK.kicad_sym">
    trait has_designator_prefix<prefix="J">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3

component PWR_BUCK:
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="TPSM53603RDAR", footprint="../../shared/elec/PWR_Texas_B3QFN-14-1EP_5x5.5mm_P0.65mm.kicad_mod", symbol="../../shared/elec/symbols/PWR_BUCK.kicad_sym">
    trait has_designator_prefix<prefix="U">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3
    signal p4 ~ pin 4
    signal p5 ~ pin 5
    signal p6 ~ pin 6
    signal p7 ~ pin 7
    signal p8 ~ pin 8
    signal p9 ~ pin 9
    signal p10 ~ pin 10
    signal p11 ~ pin 11
    signal p12 ~ pin 12
    signal p13 ~ pin 13
    signal p14 ~ pin 14
    signal p15 ~ pin 15

component PWR_DIODE:
    trait is_atomic_part<manufacturer="Diodes Incorporated", partnumber="B340A-13-F", footprint="../../shared/elec/PWR_D_SMA.kicad_mod", symbol="../../shared/elec/symbols/PWR_DIODE.kicad_sym">
    trait has_designator_prefix<prefix="D">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component PWR_TVS:
    trait is_atomic_part<manufacturer="Diodes Incorporated", partnumber="SMAJ15A-13-F", footprint="../../shared/elec/PWR_D_SMA.kicad_mod", symbol="../../shared/elec/symbols/PWR_TVS.kicad_sym">
    trait has_designator_prefix<prefix="D">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component PWR_FUSE:
    trait is_atomic_part<manufacturer="Littelfuse", partnumber="0466002.NRHF", footprint="../../shared/elec/PWR_Fuse_1206_3216Metric.kicad_mod", symbol="../../shared/elec/symbols/PWR_FUSE.kicad_sym">
    trait has_designator_prefix<prefix="F">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

component PWR_SW:
    trait is_atomic_part<manufacturer="C&K", partnumber="PCM12SMTR", footprint="../../shared/elec/PWR_SW_SPDT_PCM12.kicad_mod", symbol="../../shared/elec/symbols/PWR_SW.kicad_sym">
    trait has_designator_prefix<prefix="SW">
    signal p1 ~ pin 1
    signal p2 ~ pin 2
    signal p3 ~ pin 3

component PWR_10K:
    trait is_atomic_part<manufacturer="Yageo", partnumber="RT0603BRD0710KL", footprint="../../shared/elec/PWR_R_0603_1608Metric.kicad_mod", symbol="../../shared/elec/symbols/PWR_10K.kicad_sym">
    trait has_designator_prefix<prefix="R">
    signal p1 ~ pin 1
    signal p2 ~ pin 2

