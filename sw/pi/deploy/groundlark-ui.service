[Unit]
Description=Groundlark NiceGUI
After=network.target groundlark-station.service
StartLimitIntervalSec=0

[Service]
User=groundlark-ui
Group=groundlark-ui
WorkingDirectory=/opt/groundlark/current
EnvironmentFile=/etc/groundlark/runtime.env
Environment=HOME=/var/lib/groundlark-ui
ExecStart=/opt/groundlark/current/.venv/bin/python sw/ui/main.py --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/groundlark-ui
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
